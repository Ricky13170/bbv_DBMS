{
    "openapi": "3.0.3",
    "info": {
        "title": "DBMS REST API v1",
        "version": "1.0.0",
        "description": "Tài liệu API tương tác với Core DBMS Storage Engine"
    },
    "paths": {
        "/api/v1/databases/{db_name}/schemas/{schema_name}/tables/{table_name}": {
            "get": {
                "operationId": "v1_databases_schemas_tables_retrieve",
                "description": "Load cấu trúc 1 Bảng (TableSchema). Yêu cầu JWT Token.",
                "parameters": [
                    {
                        "in": "path",
                        "name": "db_name",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "path",
                        "name": "schema_name",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    },
                    {
                        "in": "path",
                        "name": "table_name",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "v1"
                ],
                "security": [
                    {
                        "jwtAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Chi tiết metadata của Table"
                    },
                    "401": {
                        "description": "Chưa xác thực Token"
                    }
                }
            }
        },
        "/api/v1/login": {
            "post": {
                "operationId": "v1_login_create",
                "description": "Đăng nhập để nhận Token xác thực.",
                "tags": [
                    "v1"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Login"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/Login"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/Login"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {}
                ],
                "responses": {
                    "200": {
                        "description": "Trả về JWT Access Token và Refresh Token"
                    },
                    "400": {
                        "description": "Sai định dạng input"
                    },
                    "401": {
                        "description": "Sai username hoặc password"
                    }
                }
            }
        },
        "/api/v1/system/status": {
            "get": {
                "operationId": "v1_system_status_retrieve",
                "description": "Kiểm tra trạng thái sức khỏe của DBMS Engine. Yêu cầu đăng nhập gắn Token trên Header.",
                "parameters": [
                    {
                        "in": "query",
                        "name": "include_disk_usage",
                        "schema": {
                            "type": "boolean"
                        },
                        "description": "Điền true nếu muốn API quét thêm dung lượng ổ đĩa lưu trữ"
                    }
                ],
                "tags": [
                    "v1"
                ],
                "security": [
                    {
                        "jwtAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Trạng thái hệ thống hoạt động bình thường"
                    },
                    "401": {
                        "description": "Token hết hạn hoặc không hợp lệ"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Login": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "maxLength": 50
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "maxLength": 128
                    }
                },
                "required": [
                    "password",
                    "username"
                ]
            }
        },
        "securitySchemes": {
            "jwtAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}